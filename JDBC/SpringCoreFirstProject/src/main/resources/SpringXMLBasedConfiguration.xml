<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
	<bean id="student1" class="com.scfp.entities.Student" primary="true" autowire="byName" scope="prototype">
		<constructor-arg name="id" value="1"></constructor-arg>
		<constructor-arg name="name" value="Surya"></constructor-arg>
	</bean>
	<bean id="student2" class="com.scfp.entities.Student">
		<property name="id" value="2"></property>
		<property name="name" value="Krishna"></property>
	</bean>
	<bean id="student3" class="com.scfp.entities.Student"></bean>
	
	<bean id="course" class="com.scfp.entities.Courses"></bean>
</beans>